[Unit]
Description=Streamlit Monitor Dashboard Service
After=network.target
Wants=network.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/home/ojeaburu/secure-weather-app
Environment=PATH=/home/ojeaburu/secure-weather-app/venv/bin
Environment=OPENWEATHER_API_KEY=your_api_key_here
ExecStart=/home/ojeaburu/secure-weather-app/venv/bin/streamlit run monitor.py --server.port 8600 --server.address 127.0.0.1 --server.enableCORS false --server.enableXsrfProtection false
Restart=always
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=30
KillMode=process
StandardOutput=journal
StandardError=journal
SyslogIdentifier=monitor-service

[Install]
WantedBy=multi-user.target
